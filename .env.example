# PostgreSQL connection string used by Prisma (via the pg driver adapter).
DATABASE_URL="postgresql://USER@localhost:5432/defect_tracker"

# Secret used by Auth.js to sign session JWTs. Generate one with: npx auth secret
AUTH_SECRET=

# Set to "true" so Auth.js trusts the host header in non-Vercel deployments.
AUTH_TRUST_HOST="true"
